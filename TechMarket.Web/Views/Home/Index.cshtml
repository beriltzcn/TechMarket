@model List<Product>

@{
    ViewData["Title"] = "Home";
}

<section class="tm-hero">
    <div class="container">
        <h1>The tech you want,<br /><span>all in one place.</span></h1>
        <p>
            From laptops to smart watches, from TVs to game consoles —
            everything you are looking for is at TechMarket. Fair prices, fast shipping, secure checkout.
        </p>
        <a class="tm-btn-accent" asp-controller="Product" asp-action="Index">Start shopping</a>
        <ul class="tm-hero-points">
            <li>✓ Same-day shipping</li>
            <li>✓ 14-day free returns</li>
            <li>✓ 2-year warranty</li>
        </ul>
    </div>
</section>

<div class="container pb-5">
    <div class="tm-section-head">
        <h2>New arrivals</h2>
        <a asp-controller="Product" asp-action="Index">See all →</a>
    </div>

    <div class="tm-grid">
        @foreach (var product in Model)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</div>
