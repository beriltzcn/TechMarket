@model Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1 class="mb-4">Delete Product</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this product? This action cannot be undone.
</div>

<div class="card mb-4" style="max-width: 520px;">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" />
    }
    else
    {
        <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted"
             style="height: 160px;">
            No image
        </div>
    }

    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <h6 class="card-subtitle mb-2 text-muted">@Model.Brand</h6>
        <p class="card-text mb-1">@Model.Price.ToString("N2") ₺</p>
        <span class="badge bg-secondary">@Model.Category</span>
    </div>
</div>

<form asp-controller="Product" asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Yes, delete it</button>
    <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id"
       class="btn btn-outline-secondary">Cancel</a>
</form>